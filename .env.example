# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==============================================================================
# SUPABASE CONFIGURATION
# ==============================================================================
# 1. Obtain these from your Supabase Project Settings -> API.
# 2. Never place the SUPABASE_SERVICE_ROLE_KEY in frontend code or client env vars!
#    Only the public anon key is safe for client-side applications.
# 3. Apply the SQL migration in /supabase/migrations/20261029000000_init_ojas_academy.sql
#    to enable Row Level Security (RLS) on all exposed tables.

VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
